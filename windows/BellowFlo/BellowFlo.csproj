<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows tray app. Builds on any OS (EnableWindowsTargeting), runs
       only on Windows 10/11. The speech engine is the same Python code the
       macOS app uses, in ../../kokoro. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>BellowFlo</AssemblyName>
    <RootNamespace>BellowFlo</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Bellow Flo</Product>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- waveIn capture. The rest of NAudio is not needed. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

</Project>
