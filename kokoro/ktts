#!/usr/bin/env python3
"""ktts — Bellow Flo client (controls the resident Kokoro daemon)

  ktts say "text"      speak the given text (replaces anything currently playing)
  ktts say -           speak text from stdin
  ktts clip            speak the clipboard contents
  ktts stop            stop speaking immediately
  ktts pause           pause playback
  ktts resume          resume paused playback
  ktts toggle          pause if playing, resume if paused
  ktts back [secs]     roll playback back (default 10s) and re-read
  ktts status          idle / synthesizing / playing / paused
  ktts quit            shut down the daemon (frees ~600 MB RAM; restarts on next use)

Voice/speed via env: KOKORO_VOICE, KOKORO_SPEED, KOKORO_LANG
Uses only the standard library; the daemon it launches runs in ./venv.
"""
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
sys.path.insert(0, HERE)
import bf_ipc    # noqa: E402
import bf_paths  # noqa: E402


def config():
    """Persisted defaults (written by the menu bar); env vars win."""
    return bf_paths.load_config()


def ensure_daemon():
    if bf_ipc.alive():
        return
    python = bf_paths.venv_python()
    if not os.path.exists(python):
        sys.exit(f"venv missing at {python} — run install.sh first")
    bf_paths.ensure()
    log = open(bf_paths.DAEMON_LOG, "ab")
    if os.name == "nt":
        detach = {"creationflags": subprocess.DETACHED_PROCESS
                  | subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW}
    else:
        detach = {"start_new_session": True}
    # -X utf8: on Windows the default code page cannot encode much of what
    # gets spoken, and the daemon's files and log must be UTF-8 everywhere.
    subprocess.Popen([python, "-X", "utf8", os.path.join(HERE, "daemon.py")],
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL, **detach)
    for _ in range(120):  # up to 30s for a cold start
        time.sleep(0.25)
        if bf_ipc.alive():
            return
    sys.exit(f"kokoro daemon failed to start; see {bf_paths.DAEMON_LOG}")


def send(req):
    ensure_daemon()
    reply = bf_ipc.request(req)
    print(reply.get("msg", ""))
    sys.exit(0 if reply.get("ok") else 1)


def say(text):
    cfg = config()
    send({
        "cmd": "say",
        "text": text,
        "voice": os.environ.get("KOKORO_VOICE") or cfg.get("voice", "af_heart"),
        "speed": float(os.environ.get("KOKORO_SPEED")
                       or cfg.get("speed", 1.1)),
        "lang": os.environ.get("KOKORO_LANG")
                or cfg.get("lang", "en-us"),
    })


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "say":
        rest = args[1:]
        if not rest or rest == ["-"]:
            say(sys.stdin.read())
        else:
            say(" ".join(rest))
    elif cmd == "clip":
        if os.name == "nt":
            cmd = ["powershell", "-NoProfile", "-Command",
                   "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Clipboard -Raw"]
        else:
            cmd = ["pbpaste"]
        text = subprocess.run(cmd, capture_output=True, text=True,
                              encoding="utf-8", errors="replace").stdout
        say(text)
    elif cmd == "back":
        seconds = float(args[1]) if len(args) > 1 else 10.0
        send({"cmd": "back", "seconds": seconds})
    elif cmd in ("stop", "pause", "resume", "toggle", "status", "quit"):
        if cmd in ("stop", "status", "quit"):
            # don't boot a daemon just to ask it something / stop nothing
            if not bf_ipc.alive():
                print("idle" if cmd == "status" else "not running")
                sys.exit(0)
        send({"cmd": cmd})
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main()
