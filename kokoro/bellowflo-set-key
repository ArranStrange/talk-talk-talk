#!/usr/bin/env python3
"""Store an API key for Bellow Flo in the system's credential store.

  bellowflo-set-key anthropic|openai

macOS: the key is typed straight into `security`, which prompts for it
without echoing, so it never appears in a command line, a shell history, a
config file, a log, or this process. Windows: typed at a hidden prompt and
written to Credential Manager.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
sys.path.insert(0, HERE)
import bf_secrets  # noqa: E402

PROVIDERS = {"anthropic": ("Anthropic (Claude)", "sk-ant-"),
             "openai": ("OpenAI (ChatGPT)", "sk-")}


def main():
    provider = sys.argv[1] if len(sys.argv) > 1 else ""
    if provider not in PROVIDERS:
        sys.exit("usage: bellowflo-set-key anthropic|openai")
    label, prefix = PROVIDERS[provider]
    print(f"Storing an API key for {label}.")
    print("Paste it at the prompt below — it will not be shown as you type.")
    try:
        bf_secrets.prompt_and_store(provider)
    except Exception as e:
        sys.exit(f"Not stored: {e}")

    # Report the shape of what landed, without ever showing it. Deliberately
    # no expected-length check: key formats and lengths change between
    # providers and over time, so a length rule mostly manufactures false
    # "your key is truncated" diagnoses. Only whitespace and a wrong prefix
    # are reliable signals of a bad paste.
    stored = bf_secrets.get(provider)
    print(f"\nSaved ({len(stored)} characters).")
    if not stored:
        sys.exit("WARNING: nothing was stored.")
    if not stored.startswith(prefix):
        print(f"WARNING: does not start with '{prefix}' — is this the right key?")
    if any(c.isspace() for c in stored):
        print("WARNING: the stored value contains a space or line break, which\n"
              "means the paste picked up surrounding text. Re-run and paste only\n"
              "the key.")
    print("Bellow Flo will read it from there when it needs it.\n"
          "If the provider rejects it, the likeliest causes are that the key was\n"
          "revoked, belongs to a different account, or that the account has no\n"
          "credits — not that it was mistyped.")


if __name__ == "__main__":
    main()
